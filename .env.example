# ---- LLM ----
OPENAI_API_KEY="sk-..."
# Optional: override the model (defaults to gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# ---- Market data (optional) ----
# Get a free key at https://www.alphavantage.co/support/#api-key
# If omitted, MarketMind falls back to Yahoo Finance (yfinance).
ALPHA_VANTAGE_API_KEY=""

# ---- News (optional) ----
# DuckDuckGo search needs no key. NewsAPI is optional for richer headlines.
# Get a key at https://newsapi.org/
NEWS_API_KEY=""

# ---- Memory ----
# SQLite file used by the LangGraph checkpointer for thread memory.
MARKETMIND_DB="marketmind.db"

# ---- LangSmith tracing (optional) ----
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_..."
LANGSMITH_PROJECT="marketmind-ai"
